-- Hanya: ESP (nickname + health), NoFog, FullBright
-- Minimal, self-contained implementation
-- Penulis: hasil penyederhanaan dari source.txt asli

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- CLEANUP IF SCRIPT RE-RUN
if _G._PN_SIMPLE then
    -- restore lighting if left modified
    if _G._PN_SIMPLE.restoreLighting then
        pcall(_G._PN_SIMPLE.restoreLighting)
    end
    -- remove existing ESP objects
    if _G._PN_SIMPLE.cleanupESP then
        pcall(_G._PN_SIMPLE.cleanupESP)
    end
end

-- state container
_G._PN_SIMPLE = _G._PN_SIMPLE or {}
local state = _G._PN_SIMPLE
state.espEnabled = false
state.nofogEnabled = false
state.fullbrightEnabled = false

-- store originals for restore
state._originalLighting = state._originalLighting or {}
local orig = state._originalLighting

local function storeLighting()
    if orig.stored then return end
    orig.Brightness = Lighting.Brightness
    orig.Ambient = Lighting.Ambient
    orig.ClockTime = Lighting.ClockTime
    orig.GlobalShadows = Lighting.GlobalShadows
    orig.FogEnd = Lighting.FogEnd
    orig.FogStart = Lighting.FogStart
    local ok, val = pcall(function() return Lighting.ExposureCompensation end)
    if ok then orig.ExposureCompensation = val end
    orig.stored = true
end

local function restoreLighting()
    if not orig.stored then return end
    pcall(function()
        Lighting.Brightness = orig.Brightness
        Lighting.Ambient = orig.Ambient
        Lighting.ClockTime = orig.ClockTime
        Lighting.GlobalShadows = orig.GlobalShadows
        Lighting.FogEnd = orig.FogEnd
        Lighting.FogStart = orig.FogStart
        if orig.ExposureCompensation ~= nil then
            Lighting.ExposureCompensation = orig.ExposureCompensation
        end
    end)
    orig.stored = nil
end
state.restoreLighting = restoreLighting

-- FullBright implementation
local FULLBRIGHT_SETTINGS = {
    Brightness = 2,
    Ambient = Color3.fromRGB(255,255,255),
    ClockTime = 12,
    GlobalShadows = false,
    FogEnd = 9e9,
    FogStart = 0,
    ExposureCompensation = 1,
}

local function enableFullbright()
    storeLighting()
    pcall(function()
        Lighting.Brightness = FULLBRIGHT_SETTINGS.Brightness
        Lighting.Ambient = FULLBRIGHT_SETTINGS.Ambient
        Lighting.ClockTime = FULLBRIGHT_SETTINGS.ClockTime
        Lighting.GlobalShadows = FULLBRIGHT_SETTINGS.GlobalShadows
        Lighting.FogEnd = FULLBRIGHT_SETTINGS.FogEnd
        Lighting.FogStart = FULLBRIGHT_SETTINGS.FogStart
        if FULLBRIGHT_SETTINGS.ExposureCompensation and Lighting.ExposureCompensation ~= nil then
            Lighting.ExposureCompensation = FULLBRIGHT_SETTINGS.ExposureCompensation
        end
    end)
    state.fullbrightEnabled = true
end

local function disableFullbright()
    restoreLighting()
    state.fullbrightEnabled = false
end

-- NoFog implementation (independent from fullbright but shares stored originals)
local NOFOG_SETTINGS = {
    FogEnd = 9e9,
    FogStart = 0
}

local function enableNoFog()
    storeLighting()
    pcall(function()
        Lighting.FogEnd = NOFOG_SETTINGS.FogEnd
        Lighting.FogStart = NOFOG_SETTINGS.FogStart
    end)
    state.nofogEnabled = true
end

local function disableNoFog()
    -- restore only fog values (keep other lighting modifications if fullbright active)
    pcall(function()
        if orig.FogEnd ~= nil then Lighting.FogEnd = orig.FogEnd end
        if orig.FogStart ~= nil then Lighting.FogStart = orig.FogStart end
    end)
    state.nofogEnabled = false
end

-- ESP implementation (nickname + health only, no distance)
-- Uses Highlight for visual and BillboardGui for text (so text always present)
state._esp = state._esp or {}
local esp = state._esp
esp.entries = esp.entries or {}    -- map player -> {highlight, label, conns}

local function makeNameText(plr)
    -- prefer DisplayName (nickname), fallback to Username
    local ok, dn = pcall(function() return plr.DisplayName end)
    local name = (ok and dn and tostring(dn) ~= "" ) and dn or plr.Name
    return tostring(name)
end

local function makeHealthText(hum)
    if not hum then return "0" end
    local ok, h = pcall(function() return hum.Health end)
    if not ok or not h then return "0" end
    -- simplified: integer only
    return tostring(math.floor(math.max(0, h) + 0.5))
end

local function createLabelForCharacter(char, plr)
    if not char or not plr then return nil end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
    if not root then return nil end
    -- remove existing label on this root if present
    for _, v in ipairs(root:GetChildren()) do
        if v:IsA("BillboardGui") and tostring(v.Name):match("^_PN_ESP_") then
            pcall(function() v:Destroy() end)
        end
    end
    local bg = Instance.new("BillboardGui")
    bg.Name = ("_PN_ESP_%s"):format(plr.Name)
    bg.Adornee = root
    bg.AlwaysOnTop = true
    bg.Size = UDim2.new(0, 120, 0, 40)
    bg.StudsOffset = Vector3.new(0, 3, 0)
    local label = Instance.new("TextLabel", bg)
    label.Name = "ESPLabel"
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1,0,1,0)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 14
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0.6
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.TextXAlignment = Enum.TextXAlignment.Center
    -- initial text: nickname and health number only, newline separated
    local hum = char:FindFirstChildOfClass("Humanoid")
    label.Text = makeNameText(plr) .. "\n" .. makeHealthText(hum)
    bg.Parent = root
    return bg, label
end

local function createHighlight(char, plr)
    if not char or not plr then return nil end
    local ok, h = pcall(function()
        local inst = Instance.new("Highlight")
        inst.FillColor = Color3.fromRGB(255, 0, 0)
        inst.OutlineColor = Color3.fromRGB(0,0,0)
        inst.Adornee = char
        inst.Name = ("_PN_ESP_HL_%s"):format(plr.Name)
        inst.Parent = Workspace
        return inst
    end)
    if ok and h and h:IsA("Highlight") then
        return h
    end
    return nil
end

local function addESPForPlayer(plr)
    if not plr or plr == LocalPlayer then return end
    if esp.entries[plr] then return end
    esp.entries[plr] = {highlight = nil, label = nil, labelObj = nil, conns = {}}
    local function onCharacter(char)
        -- cleanup previous
        local entry = esp.entries[plr]
        if entry then
            if entry.highlight then pcall(function() entry.highlight:Destroy() end) entry.highlight = nil end
            if entry.labelObj then pcall(function() entry.labelObj:Destroy() end) entry.labelObj = nil end
            for _, c in ipairs(entry.conns) do
                pcall(function() c:Disconnect() end)
            end
            entry.conns = {}
        end
        if not char then return end
        -- create highlight (visual) and label (text)
        local h = createHighlight(char, plr)
        local bg, lbl = createLabelForCharacter(char, plr)
        if esp.entries[plr] then
            esp.entries[plr].highlight = h
            esp.entries[plr].label = lbl
            esp.entries[plr].labelObj = bg
        end
        -- connect health updates
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and lbl then
            local ch = hum:GetPropertyChangedSignal("Health"):Connect(function()
                pcall(function()
                    lbl.Text = makeNameText(plr) .. "\n" .. makeHealthText(hum)
                end)
            end)
            table.insert(esp.entries[plr].conns, ch)
            -- also update on Died/Respawn
            local diedConn = hum.Died:Connect(function()
                pcall(function() lbl.Text = makeNameText(plr) .. "\n0" end)
            end)
            table.insert(esp.entries[plr].conns, diedConn)
        end
    end
    -- if current character exists, add for it
    if plr.Character then
        onCharacter(plr.Character)
    end
    -- keep it persistent
    local conn = plr.CharacterAdded:Connect(onCharacter)
    table.insert(esp.entries[plr].conns, conn)
end

local function removeESPForPlayer(plr)
    if not plr then return end
    local entry = esp.entries[plr]
    if not entry then return end
    if entry.highlight then pcall(function() entry.highlight:Destroy() end) end
    if entry.labelObj then pcall(function() entry.labelObj:Destroy() end) end
    if entry.label and entry.label.Parent then
        pcall(function() entry.label:Destroy() end)
    end
    for _, c in ipairs(entry.conns or {}) do
        pcall(function() c:Disconnect() end)
    end
    esp.entries[plr] = nil
    -- also remove any leftover instances named with our prefixes
    for _, v in ipairs(Workspace:GetDescendants()) do
        if (v:IsA("Highlight") or v:IsA("BillboardGui")) and tostring(v.Name):match("^_PN_ESP_") then
            pcall(function() v:Destroy() end)
        end
    end
end

local function enableESP()
    if state.espEnabled then return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            addESPForPlayer(plr)
        end
    end
    esp.playerAddedConn = Players.PlayerAdded:Connect(function(plr)
        if plr ~= LocalPlayer then
            addESPForPlayer(plr)
        end
    end)
    esp.playerRemovingConn = Players.PlayerRemoving:Connect(function(plr)
        removeESPForPlayer(plr)
    end)
    state.espEnabled = true
end

local function disableESP()
    if not state.espEnabled then return end
    if esp.playerAddedConn then pcall(function() esp.playerAddedConn:Disconnect() end) esp.playerAddedConn = nil end
    if esp.playerRemovingConn then pcall(function() esp.playerRemovingConn:Disconnect() end) esp.playerRemovingConn = nil end
    for plr, _ in pairs(esp.entries) do
        removeESPForPlayer(plr)
    end
    state.espEnabled = false
end

function state.cleanupESP()
    disableESP()
end

-- Public API
local API = {}

function API.ToggleFullBright(v)
    if v == nil then v = not state.fullbrightEnabled end
    if v then enableFullbright() else disableFullbright() end
    return state.fullbrightEnabled
end

function API.ToggleNoFog(v)
    if v == nil then v = not state.nofogEnabled end
    if v then enableNoFog() else disableNoFog() end
    return state.nofogEnabled
end

function API.ToggleESP(v)
    if v == nil then v = not state.espEnabled end
    if v then enableESP() else disableESP() end
    return state.espEnabled
end

